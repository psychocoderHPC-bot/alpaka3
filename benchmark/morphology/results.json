  "reference_caveats": [
    "The HeCBench CUDA reference is the performance baseline on GPU; its block vHGW two-way scan is fastest for large structuring elements, which is why the sliding-window port's advantage grows as the structuring element shrinks (ratio 0.07 at hsize=5).",
    "The HeCBench morphology-omp reference is an OpenMP target-offload program for icpx (absent on rosi_v100); built with g++ -fopenmp it falls back to the host and hangs under 'omp target teams', so it is not a usable CPU performance or correctness baseline. CPU correctness uses the exact independent host oracle."
  ],
  "repro_commands": {
    "cpu_build": "cmake --preset rel-host-cpu-gcc -Dalpaka_COMPILE_PEDANTIC=ON . && cmake --build build/rel-host-cpu-gcc --target morphology_alpaka -j",
    "cpu_run": "OMP_NUM_THREADS=48 ./build/rel-host-cpu-gcc/benchmark/morphology/morphology_alpaka --width 999 --height 777 --hsize 71 --vsize 71 --repeat 20 --samples 5 --seed 12345",
    "ctest": "ctest --test-dir build/rel-host-cpu-gcc -R morphology_alpaka --output-on-failure",
    "gpu_configure_build": "PATH=/usr/local/cuda-12.6/bin:$PATH CUDA_HOME=/usr/local/cuda-12.6 cmake --preset rel-cuda-nvcc-gcc -DCMAKE_CUDA_ARCHITECTURES=70 -Dalpaka_COMPILE_PEDANTIC=ON . && cmake --build build/rel-cuda-nvcc-gcc --target morphology_alpaka -j",
    "gpu_run": "CUDA_VISIBLE_DEVICES=3 ./build/rel-cuda-nvcc-gcc/benchmark/morphology/morphology_alpaka --width 999 --height 777 --hsize 71 --vsize 71 --repeat 100 --samples 5 --seed 12345",
    "reference_cuda": "nvcc -std=c++17 -Xcompiler -Wall -arch=sm_70 -O3 main.cu morphology.cu -o morphology_cuda_ref && CUDA_VISIBLE_DEVICES=3 ./morphology_cuda_ref <hsize> <vsize> <width> <height> <repeat>"
  }
