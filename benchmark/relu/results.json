  "repro_commands": {
    "cpu_build": "cmake --preset rel-host-cpu-gcc -Dalpaka_COMPILE_PEDANTIC=ON . && cmake --build build/rel-host-cpu-gcc --target relu_alpaka -j",
    "cpu_run": "./build/rel-host-cpu-gcc/benchmark/relu/relu_alpaka --size 10000000 --repeat 5",
    "gpu_build": "PATH=/usr/local/cuda-12.6/bin:$PATH CUDA_HOME=/usr/local/cuda-12.6 cmake --preset rel-cuda-nvcc-gcc -DCMAKE_CUDA_ARCHITECTURES=70 -Dalpaka_COMPILE_PEDANTIC=ON . && cmake --build build/rel-cuda-nvcc-gcc --target relu_alpaka -j",
    "gpu_run": "./build/rel-cuda-nvcc-gcc/benchmark/relu/relu_alpaka --size 10000000 --repeat 5",
    "cta_test": "ctest --test-dir build/rel-host-cpu-gcc -R relu_alpaka",
    "reference_cuda": "nvcc -std=c++17 -Xcompiler -Wall -arch=sm_70 -O3 src/relu-cuda/main.cu -o main ; ./main 10000000 5",
    "reference_omp": "g++ -O2 -fopenmp -std=c++17 -I../relu-cuda main.cpp -o main_omp ; OMP_NUM_THREADS=14 ./main_omp 10000000 5"
