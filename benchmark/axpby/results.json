    {"config": "200 tensors (110,219,593 elements)", "chunk_size": 512, "data_type": "fp32", "backend": "CpuSerial", "platform": "cpu", "alpaka_median_us": 54958.741, "reference_median_us": 6562221.5, "reference": "HeCBench OMP offload chunk512", "ratio_alpaka_over_ref": 0.008, "variation_us": 7568.636, "validation": "PASS"}
