  "alpaka": {
    "base_commit": "6f13700c390a09df818a255d53e730f1f9d69456",
    "branch": "benchmark/axpby",
    "commit": "4a66cf3efdbabcef50fbb39d0a4733a0976d85ea"
  },
  "sampling": "one discarded warm-up, then --repeat 5 measured iterations; reported value is the median. GPU 1000-tensor row aggregates 4 independent runs, 2000-tensor row 2 runs; CPU rows 5 runs.",
  "timing_scope": "kernel enqueue + device synchronization only",
  "environment": {
    "cpu": "local 14-core x86_64, GCC 13.3.0, -O3, OMP_NUM_THREADS=14, alpaka backend CpuOmpBlocks / CpuSerial",
    "gpu": "rosi_v100: NVIDIA Tesla V100-SXM2-32GB, sm_70, CUDA 12.6, g++ 13.2, alpaka backend GpuCuda"
  },
  "tolerance": {
    "absolute": 1e-3,
    "relative": 1e-6,
    "rationale": "Inputs are non-negative integers < 2^20 with a=b=1, so x+y < 2^24 is exact in fp32 and the double reference is exact; the relative term only absorbs contraction differences."
  },
  "reference_caveats": [
    "The HeCBench OpenMP reference is an OpenMP-offload program; host-side its target-teams fallback serialises, so CPU ratios are indicative, not like-for-like. CpuOmpBlocks is the meaningful CPU number."
  ],
  "results": [
