    {"config": "50 tensors (28,639,101 elements)", "chunk_size": 512, "data_type": "fp32", "backend": "CpuSerial", "platform": "cpu", "alpaka_median_us": 14133.491, "reference_median_us": 1679035.0, "reference": "HeCBench OMP offload chunk512", "ratio_alpaka_over_ref": 0.008, "variation_us": 1918.596, "validation": "PASS"},
