{
  "benchmark": "axpby",
  "hecbench": {
    "repo": "https://github.com/ORNL/HeCBench",
    "commit": "0a17ee47ca6072192101036d4bf292e6612f22e6",
    "source_files": {
      "axpby-cuda/main.cu": {"sha256": "1d95cef0013eec212ce5616029a24b3d702cea50a05f301a10ebfbf1088de50c"},
      "axpby-cuda/multi_tensor_apply.cuh": {"sha256": "13118aa1ca3998212bcea0df909bd13237f3c7acbd856cfb19c8b1fe5dfa9954"},
