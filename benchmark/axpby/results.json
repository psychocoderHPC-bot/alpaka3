  "irregular_validation": [
    "4x4093/chunk512 PASS",
    "1x2/chunk1 PASS",
    "3x257/chunk256 PASS",
    "5x1000/chunk7 PASS"
  ],
  "repro_commands": [
    "cmake --preset rel-host-cpu-gcc -Dalpaka_COMPILE_PEDANTIC=ON -Dalpaka_TESTS=OFF -Dalpaka_EXAMPLES=OFF -Dalpaka_DOCS=OFF -S . -B build/rel-host-cpu-gcc",
    "cmake --build build/rel-host-cpu-gcc --target axpby_alpaka -j",
