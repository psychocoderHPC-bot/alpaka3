{
  "benchmark": "memcpy",
  "protocol_run": "hecbench-alpaka3-2026-10-10",
  "hecbench": {
    "repo": "https://github.com/ORNL/HeCBench",
    "sha": "0a17ee47ca6072192101036d4bf292e6612f22e6",
    "cuda_source": {
      "path": "src/memcpy-cuda/main.cu",
      "blob": "4a9230f9c3cf98854c5eea1d52dcb782ac25cfb4"
    },
    "omp_source": {
      "path": "src/memcpy-omp/main.cpp",
      "blob": "4f8d7f585f7289d26398720d7be57e895b75ba5e"
    }
  },
  "reference_build": {
    "cuda": "nvcc -std=c++17 -Xcompiler -Wall -arch=sm_70 -O3 main.cu -o memcpy_cuda_ref",
    "omp": "g++ -O2 -fopenmp -std=c++17 main_omp.cpp -o memcpy_omp_ref"
  },
  "machine": {
    "cpu": "Intel(R) Xeon(R) Gold 6136 CPU @ 3.00GHz (2 sockets x 12 cores, 48 HT)",
    "gpu": "Tesla V100-SXM2-32GB (CUDA_VISIBLE_DEVICES=1)",
    "cuda": "12.6",
    "gcc": "13.2.0",
    "cmake": "3.28.3"
  },
  "build": {
    "cpu": "cmake --preset rel-host-cpu-gcc -Dalpaka_COMPILE_PEDANTIC=ON .",
    "gpu": "cmake --preset rel-cuda-nvcc-gcc -DCMAKE_CUDA_ARCHITECTURES=70 -Dalpaka_COMPILE_PEDANTIC=ON ."
  },
  "sampling": {
    "timing_scope": "repeat back-to-back enqueues between two synchronisations, divided by repeat",
    "warmup": 1,
    "samples": 5,
    "metric": "median per-copy time in microseconds"
  },
  "validation": {
    "tolerance": "0 (byte-exact)",
    "rationale": "deterministic position-dependent pattern; destination poisoned with the inverse pattern before the copy, so a skipped/truncated/shifted copy fails at a known offset. A byte payload read as float is often NaN, so an exact byte compare is strictly stronger than a NaN/Inf test.",
    "nonzero_exit_on_failure": true,
    "validated_sizes": [
      1,
      2,
      3,
      7,
      15,
      63,
      64,
      65,
      127,
      255,
      256,
      257,
      511,
      512,
      513,
      1000,
      1023,
      1024,
      1025,
      4095,
      4096,
      4097,
      65535,
      65536,
      65537,
      1048575,
      1048576,
      1048577
    ],
    "modes": [
      "h2d",
      "d2h",
      "d2d"
    ],
    "backends": [
      "CpuOmpBlocks",
      "GpuCuda"
    ]
  },
