  "repro_commands": {
    "cpu_configure": "cmake --preset rel-host-cpu-gcc -Dalpaka_COMPILE_PEDANTIC=ON -Dalpaka_TESTS=OFF -Dalpaka_EXAMPLES=OFF -Dalpaka_DOCS=OFF .",
    "cpu_build": "cmake --build build/rel-host-cpu-gcc --target cross_alpaka -j",
    "cpu_run": "./build/rel-host-cpu-gcc/benchmark/cross/cross_alpaka --size 10000000 --repeat 5 --dtype both",
    "cta_test": "ctest --test-dir build/rel-host-cpu-gcc -R cross_alpaka",
    "gpu_configure": "export PATH=/usr/local/cuda-12.6/bin:$PATH; export CUDA_HOME=/usr/local/cuda-12.6; cmake --preset rel-cuda-nvcc-gcc -DCMAKE_CUDA_ARCHITECTURES=70 -Dalpaka_COMPILE_PEDANTIC=ON -Dalpaka_TESTS=OFF -Dalpaka_EXAMPLES=OFF -Dalpaka_DOCS=OFF .",
    "gpu_build": "cmake --build build/rel-cuda-nvcc-gcc --target cross_alpaka -j",
    "gpu_run": "./build/rel-cuda-nvcc-gcc/benchmark/cross/cross_alpaka --size 10000000 --repeat 5 --dtype both",
    "reference_cuda": "cd HeCBench/src/cross-cuda && nvcc -std=c++17 -Xcompiler -Wall -arch=sm_70 -O3 main.cu -o cross_cuda_ref && ./cross_cuda_ref 10000000 5",
    "reference_omp": "cd HeCBench/src/cross-omp && g++ -O2 -fopenmp -std=c++17 main.cpp -o cross_omp_ref && OMP_NUM_THREADS=14 ./cross_omp_ref 10000000 5"
